aws_region = "ap-south-1"


#----------------------------------------------------------
# common_tags
#----------------------------------------------------------

name_prefix = "app13-dev"

common_tags = {
  Environment = "dev"
  Project     = "app13"
  ManagedBy   = "terraform"
}


#----------------------------------------------------------
# VPC
#----------------------------------------------------------

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "ap-south-1a",
  "ap-south-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

enable_nat_gateway = true


#----------------------------------------------------------
# EKS
#----------------------------------------------------------

eks_cluster_version = "1.34"

node_instance_types = [
  "t3.medium"
]

capacity_type = "SPOT" ## or "ON_DEMAND"

desired_size = 2
min_size     = 1
max_size     = 3


#----------------------------------------------------------
# ECR
#----------------------------------------------------------

ecr_repo_name        = "nginx-app-dev"
image_tag_mutability = "MUTABLE"
